NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for secure uploads, rate limiting, and server-side operations
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into the dashboard. When empty, the
# admin_allowlist table is used instead (access is denied if neither matches).
ADMIN_ALLOWED_EMAILS=

# Optional: VirusTotal API key for malware scanning on uploads
VIRUSTOTAL_API_KEY=

# Public address of the portfolio site (used for "View site", review and contract links)
NEXT_PUBLIC_SITE_URL=https://almayostudio.com
